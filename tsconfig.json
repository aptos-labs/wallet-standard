{
  "compilerOptions": {
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ES2022",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "outDir": "./dist",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": ["src", "tsup.config.ts"]
}
