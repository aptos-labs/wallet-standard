{
  "name": "@aptos-labs/wallet-standard",
  "description": "Aptos wallet standard",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "homepage": "https://github.com/aptos-labs/wallet-standard",
  "bugs": {
    "url": "https://github.com/aptos-labs/wallet-standard/issues/new/choose"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rm -rf ./dist",
    "dev": "tsc --watch",
    "build": "pnpm build:clear && tsc",
    "build:clear": "rm -rf ./dist",
    "prepublishOnly": "pnpm build",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "peerDependencies": {
    "@aptos-labs/ts-sdk": "^7.0.0",
    "@wallet-standard/core": "^1.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "typescript": "^6.0.2"
  }
}
