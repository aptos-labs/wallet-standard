{
  "name": "@aptos-labs/wallet-standard",
  "description": "Aptos wallet standard",
  "version": "0.6.0",
  "packageManager": "pnpm@10.13.1",
  "license": "Apache-2.0",
  "homepage": "https://github.com/aptos-labs/wallet-standard",
  "bugs": {
    "url": "https://github.com/aptos-labs/wallet-standard/issues/new/choose"
  },
  "sideEffects": false,
  "main": "dist/common/index.js",
  "module": "dist/esm/index.mjs",
  "types": "./dist/common/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "require": {
        "types": "./dist/common/index.d.ts",
        "default": "./dist/common/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rm -rf ./dist",
    "dev": "pnpm build --watch",
    "build": "pnpm build:clear && tsup",
    "build:clear": "rm -rf ./dist",
    "prepublishOnly": "pnpm build",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "peerDependencies": {
    "@aptos-labs/ts-sdk": "^3.1.3 || ^4.0.0 || ^5.0.0",
    "@wallet-standard/core": "^1.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
