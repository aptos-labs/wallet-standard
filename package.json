{
  "name": "@aptos-labs/wallet-standard",
  "description": "Aptos wallet standard",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "homepage": "https://github.com/aptos-labs/wallet-standard",
  "repository": {
    "type": "git",
    "url": "https://github.com/aptos-labs/wallet-standard"
  },
  "bugs": {
    "url": "https://github.com/aptos-labs/wallet-standard/issues/new/choose"
  },
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rm -rf ./dist",
    "dev": "tsc --watch",
    "build": "pnpm build:clear && tsc",
    "build:clear": "rm -rf ./dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:publish": "publint && attw --pack . --ignore-rules no-resolution cjs-resolves-to-esm",
    "prepublishOnly": "pnpm build && pnpm check:publish",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "peerDependencies": {
    "@aptos-labs/ts-sdk": "^7.1.0",
    "@wallet-standard/core": "^1.0.3"
  },
  "devDependencies": {
    "@aptos-labs/ts-sdk": "^7.1.0",
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "2.4.6",
    "@vitest/coverage-v8": "^4.1.7",
    "publint": "^0.3.21",
    "typescript": "^6.0.2",
    "vitest": "^4.1.7"
  }
}
